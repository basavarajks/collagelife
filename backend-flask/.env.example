FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-strong-random-value
FRONTEND_ORIGIN=http://localhost:5173
TOKEN_TTL_SECONDS=3600

# Preferred single URI (MySQL/MariaDB via XAMPP)
DATABASE_URL=mysql+pymysql://<username>:<password>@127.0.0.1:3306/sdms_db

# Optional split variables if DATABASE_URL is not used
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sdms_db
